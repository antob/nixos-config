Add missing <linux/string.h> includes and replace removed strncpy() with strscpy().

Upstream calls kernel string functions (strncpy, strnlen, strcmp, strpbrk, ...)
without including <linux/string.h>; it used to compile via transitive includes.
Kernel 7.2.2 (linuxPackages_latest) with GCC 15 makes the implicit declaration
a hard error, and 7.x removed the strncpy() API entirely, so the five sysfs
attribute copies in ddcci.c must use strscpy() (already used elsewhere in the driver).

Upstream: https://gitlab.com/ddcci-driver-linux/ddcci-driver-linux
ref bbb7553373f815d78e93a4a9f071ce968563694a)

--- a/ddcci/ddcci.c	2025-09-27 00:45:36.000000000 +0200
+++ b/ddcci/ddcci.c	2026-09-02 21:47:44.028903715 +0200
@@ -22,6 +22,7 @@
 #include <linux/mutex.h>
 #include <linux/rwsem.h>
 #include <linux/slab.h>
+#include <linux/string.h>
 #include <linux/uaccess.h>
 #include <linux/version.h>
 
@@ -765,7 +766,7 @@
 
 	if (likely(device != NULL)) {
 		len = strnlen(device->prot, sizeof(device->prot));
-		strncpy(buf, device->prot, PAGE_SIZE);
+		strscpy(buf, device->prot, PAGE_SIZE);
 		if (len == 0) {
 			ret = len;
 		} else if (likely(len < PAGE_SIZE)) {
