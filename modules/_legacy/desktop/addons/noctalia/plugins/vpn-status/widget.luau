--!nonstrict
-- VPN status bar widget. A VPN counts as active while its network interface
-- exists, the same check dm-networkd-vpn uses. Works for both wg-quick and
-- snx-rs (its `if-name`) without spawning any process.
--
-- vpns.json (generated by Nix):
--   { "vpns": [ { "interface": "protonvpn0", "label": "Proton VPN" }, ... ],
--     "menu": "/nix/store/...-dm-networkd-vpn/bin/dm-networkd-vpn" }

local function loadConfig()
  local path = noctalia.pluginDir() .. "/vpns.json"
  local raw, readErr = noctalia.readFile(path)
  if raw == nil then
    noctalia.log(`vpn-status: cannot read {path}: {readErr}`)
    return nil
  end
  local decoded, decodeErr = noctalia.json.decode(raw)
  if decoded == nil then
    noctalia.log(`vpn-status: cannot parse {path}: {decodeErr}`)
    return nil
  end
  return decoded
end

local config = loadConfig() or {}
local vpns = config.vpns or {}
local lastState = nil

noctalia.setUpdateInterval(noctalia.getConfig("poll_interval_ms") or 2000)

local function render(activeLabels, isUp)
  local anyActive = #activeLabels > 0

  barWidget.setVisible(anyActive or not noctalia.getConfig("hide_inactive"))
  barWidget.setGlyph(if anyActive then "shield-lock" else "shield-off")
  barWidget.setGlyphColor(
    if anyActive then noctalia.getConfig("active_color") else noctalia.getConfig("inactive_color")
  )

  if anyActive and noctalia.getConfig("show_label") then
    local text = activeLabels[1]
    if #activeLabels > 1 then
      text ..= ` +{#activeLabels - 1}`
    end
    barWidget.setText(text)
  else
    barWidget.setText("")
  end

  if #vpns == 0 then
    barWidget.setTooltip(noctalia.tr("tooltip.none"))
    return
  end
  local rows = {}
  for i, vpn in ipairs(vpns) do
    local status = if isUp[i] then noctalia.tr("tooltip.connected") else noctalia.tr("tooltip.disconnected")
    table.insert(rows, { key = vpn.label, value = status })
  end
  barWidget.setTooltip(rows)
end

function update()
  local activeLabels = {}
  local isUp = {}
  for i, vpn in ipairs(vpns) do
    isUp[i] = noctalia.fileExists("/sys/class/net/" .. vpn.interface)
    if isUp[i] then
      table.insert(activeLabels, vpn.label)
    end
  end

  -- Only touch the widget when something changed.
  local state = table.concat(activeLabels, "\n")
  if state == lastState then
    return
  end
  lastState = state
  render(activeLabels, isUp)
end

function onClick()
  if config.menu == nil then
    noctalia.notifyError(noctalia.tr("notifications.config_error"))
    return
  end
  noctalia.runAsync(config.menu)
end
